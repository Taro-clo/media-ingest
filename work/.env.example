# =============================================================================
# NAS 媒体库硬链接管理器 —— 环境变量示例
# =============================================================================
# 用法：
#     cp .env.example .env
#     按需修改下面各项（至少确认 PUID / PGID / MEDIA_ROOT）
#     docker compose up -d --build
#
# ⚠️ 重要：`.env` **不会被应用代码读取**，它只被 `docker compose` 用来填充
#    docker-compose.yml 里的 ${VAR} 插值；容器内的真实环境变量来自 compose 的
#    environment: 段。两者配合才生效，缺一不可 —— 本文件里每个 `${VAR}` 都能在
#    docker-compose.yml 的 `environment:` 段里找到同名的一行（含 MEDIA_ROOT：它既
#    参与 volumes 插值，也传进容器供 entrypoint 做只读结构检查）。
#
# ⚠️ `.env` 含密钥，已在 .gitignore 中（`.env` / `.env.*`，但保留 `.env.example`）。
#
# 语法约定：`KEY=值`，等号两侧不要有空格；值若含空格/特殊字符请用双引号包裹。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 运行身份（**必需**，已给默认值；**最常需要改的两项**）
# -----------------------------------------------------------------------------
# 容器内 app 用户的 uid。下载源与媒体库通常归你运行下载的那个用户所有（示例 uid 1000），
# 所以默认 1000 —— 不要随意改成 0（root）。
# 查询方法：在 NAS 上执行 `id youruser` 或 `stat -c '%u %g %n' /vol1/1000/Download/qbittorrent`
PUID=1000

# 容器内 app 用户的主 gid。NAS 上该用户的主组通常是 Users，gid 常见为 1001
# （按 `id <你的用户>` 的结果填）。该 gid 要能写 /vol1/1000/Library。
# 查询方法：`id youruser` → 形如 `uid=1000(youruser) gid=1001(Users)`
PGID=1001


# -----------------------------------------------------------------------------
# 2. 时区与字符集（**必需**，一般**无需修改**）
# -----------------------------------------------------------------------------
# 日志时间戳用的时区。国内 NAS 用 Asia/Shanghai。
TZ=Asia/Shanghai

# 这三个是兼容性硬要求：
# 现行硬链接实现（app/processors/hardlink.py）用 open(LOG_FILE) 且**未指定 encoding**，依赖进程 locale。
# 改成 C / POSIX 会导致中文日志写入报 UnicodeEncodeError 或产生乱码。
# 一般无需修改。
LANG=C.UTF-8
PYTHONUTF8=1
PYTHONIOENCODING=utf-8


# -----------------------------------------------------------------------------
# 3. 挂载形态：**单一共同父挂载**（**必需**，**最关键的一项**）
# -----------------------------------------------------------------------------
# 源目录（qBittorrent 下载）与目标媒体库（硬链接落地点）的**共同父目录**（宿主路径）。
# compose 把它挂成**一条** bind，并且容器内路径 = 宿主路径：
#     - ${MEDIA_ROOT:-/vol1/1000}:${MEDIA_ROOT:-/vol1/1000}
# 例：MEDIA_ROOT=/vol1/1000 ⇒ 容器内同时能看到
#     /vol1/1000/Download/qbittorrent   （源）
#     /vol1/1000/Library                （目标）
#
# ⚠️⚠️ **为什么必须这样：硬链接不能跨挂载**。
#    Linux 的 `link()`/`linkat()` 在内核 `fs/namei.c: do_linkat()` 里比较的是
#    **挂载身份**（`old_path.mnt != new_path.mnt`），不是 `st_dev`、不是文件系统 UUID、
#    也不是 btrfs 子卷。两个目录**即使 `stat -c %d` 完全相同**，只要它们来自
#    **两条独立的 bind**，就是两个不同 mount ⇒ 必然返回
#    **[Errno 18] EXDEV (Invalid cross-device link)**。
#    （btrfs，同 st_dev、同 fsid、同子卷 id 也不例外）：两条 bind ⇒ 硬链接 100% 失败；
#    合成一条共同父挂载 ⇒ 立即成功：源与目标本来就在同一个挂载里（示例：同属 /vol1）。
#
# ⇒ **绝对不要再把源与目标拆成两条 bind**（`/downloads:ro` + `/library` 是错误形态）。
#   拆了的现象：任务 status=failed、`link_failed` > 0，日志与任务结果里是
#   `[Errno 18] Invalid cross-device link`；库目录里只会落下部分目录结构。
#   本应用**绝不回退为复制文件**（复制会让媒体库体积瞬间翻倍，且源文件后来被改写时
#   库里的副本不会跟着变，静默产生语义错误）——跨挂载时宁可任务失败。
#
# ⚠️ MEDIA_ROOT 必须是宿主上**真实存在**的目录：Docker 会对不存在的 bind 源路径
#   以 root 创建目录，那会凭空造出一个空的 /vol1/1000 并遮蔽真实数据。
#   自查：`ls -ld /vol1/1000/Download/qbittorrent /vol1/1000/Library`
#
# ⚠️ 失去了 `/downloads:ro` 这层"结构性只读保证"（单挂载形态下，内核让
#   "源单独 :ro 挂载"与"跨路径硬链接"互斥，二者不可兼得）。替代保证是**可验证的**：
#     ① 代码层永不写源目录（只 stat / walk / link；link 只增加源 inode 链接计数）；
#     ② 任务前后**逐文件源完整性核对**（`Task.result.source_integrity`，
#        差异会写进 `result.warnings[]`）；
#     ③ 测试 `tests/test_no_source_mutation.py`；
#     ④ entrypoint 绝不 chown/chmod/mkdir 媒体挂载下的任何路径（只递归 /data）。
#   详见 docker-compose.yml 文件头第 3/4 点。
MEDIA_ROOT=/vol1/1000

# ⚠️ 配套提醒：改了 MEDIA_ROOT 之后，容器内路径随之改变，**DB 里已存的
#    「允许的源根目录 / 允许的目标根目录」不会自动跟着变**。正确改法：
#      WebUI「设置」页 → 允许的源根目录 / 允许的目标根目录 → 改成宿主真实路径
#      （例 /vol1/1000/Download/qbittorrent 、 /vol1/1000/Library）
#    否则容器会 unhealthy：checks.downloads_readable / library_writable 为 false。


# -----------------------------------------------------------------------------
# 4. 应用路径与端口（**必需**，已给默认值）
# -----------------------------------------------------------------------------
# 数据目录（容器内路径）。持久化 SQLite、任务日志、每库日志文件、secret.key。
# 一般无需修改；宿主侧对应 docker-compose.yml 里的 /data bind：
#   NAS 部署时即 /vol1/1000/Docker/media-ingest/data
# ⚠️ 若把它改成 /data 以外的路径，请**同时**设 CONFIG_DIR（entrypoint 会用
#    ${DATA_DIR}/config 兜底，但显式写出来最不容易踩坑）：否则容器会在
#    /data/config 上撞到"对 uid 1000 不可写"而拒绝启动。
DATA_DIR=/data

# 应用监听端口（容器内）。宿主映射端口 = 此值（见 compose 的 ports）。
# 默认 18081；如与已有服务冲突就改成你要的端口（宿主与容器两侧同步移动）。
PORT=18081

# 配置文件镜像目录（容器内路径）。里面是 libraries.yaml 与 processors/*.yaml，
# 由 WebUI 每次保存时原子写出，宿主机可以直接编辑（改完会被自动导入）。
# 它位于 /data 卷内，**不需要**单独挂载；想单独备份配置时可另加一条 bind，见 compose。
# 一般无需修改。
CONFIG_DIR=/data/config

# ⚠️ **没有** CONFIG_SYNC_INTERVAL_SECONDS 这个环境变量（别在这里加）。
#   配置同步周期的唯一真源是**数据库设置键** `config_sync_interval_seconds`：
#   默认 5 秒、区间 0–86400 秒、**0 = 后台线程仍启动但不导入外部改动**
#   （即"关闭外部文件同步"，只保留 WebUI 上的手工「重新导入」）。
#   改它请用 WebUI「设置」页，或 PUT /api/settings；写成 env 不会生效。
#
# ⚠️ 宿主侧数据目录本身不是环境变量，它写在 compose 的 volumes 里，可用
#   MLM_DATA_DIR 覆盖（默认 /vol1/1000/Docker/media-ingest/data）。
#   换目录时先建好并 `chown -R 1000:1001 <dir>`，否则 Docker 会以 root 建目录。

# 提醒：**日志不在 /data/config 里**。库日志与 hard_links.log 都在 /data/logs
#   （两者同属 /data 卷）。只单独 bind 了 config 目录的人，备份里没有日志；
#   想完整备份就备份整个 /data。

# ---- 首次建库时的"允许的源/目标根目录"缺省值 ----
# 语义：**只用于 DB 首次播种**（SQLite 里还没有这两条设置时写进去的初值）。
#   DEFAULT_SOURCE_ROOT → 设置键 allowed_source_roots 的初值
#   DEFAULT_TARGET_ROOT → 设置键 allowed_target_roots 的初值
# ⚠️ DB 一旦存在，改这里**不生效**。已部署实例要改白名单，请用 WebUI「设置」页
#    （或 PUT /api/settings）改「允许的源根目录 / 允许的目标根目录」。
# ⚠️ 因为容器路径 = 宿主路径（见第 3 节），这两个值写**宿主真实路径**。
# ⚠️ 旧 DB 里若这两个值仍是 `/downloads`、`/library`（容器内已不存在）
#    ⇒ healthcheck 的 downloads_readable / library_writable 为 false
#    ⇒ 容器 unhealthy。修法：到设置页改成下面这两行同样的值。
# ⚠️ 源根的缺省值是**整个下载树** `/vol1/1000/Download`（不是它下面的 qbittorrent 子目录）：
#    这样才能给 Download 下任意子目录建库。要收紧就改成 `/vol1/1000/Download/qbittorrent`，
#    然后在设置页同步改「允许的源根目录」。
DEFAULT_SOURCE_ROOT=/vol1/1000/Download
DEFAULT_TARGET_ROOT=/vol1/1000/Library


# -----------------------------------------------------------------------------
# 5. 可选：路径映射（容器内绝对路径 -> 宿主路径；**只用于展示与路径换算**）
# -----------------------------------------------------------------------------
# JSON 字符串：键 = **容器内绝对路径**（必须以 / 开头），值 = 对应的宿主（NAS）路径。
#
# 容器路径 = 宿主路径（单一共同父挂载），所以默认值就是一个**恒等映射**：
#     {"/vol1/1000":"/vol1/1000"}
# 只有迁移到"非恒等"部署（例如容器内仍是 /downloads、/library）时才需要覆盖它。
#
# 它的作用只有两件事，**都不参与文件操作**（写文件、建硬链接一律用容器路径）：
#   a) WebUI 展示：把容器路径翻成你熟悉的宿主路径；
#   b) 路径换算：你在 WebUI 里手填宿主路径时，应用按这张映射换成容器路径再存库
#      （最长前缀优先，已是容器路径的不再换算）。
#
# ⚠️ 硬链接日志从零开始写在 /data/logs/hard_links.log 里，记录的**本来就是容器路径**，
#    因此不需要、也没有任何"把宿主前缀翻成容器前缀"的迁移步骤。
#
# 三条要点：
#   1) 键必须是以 `/` 开头的绝对容器路径；值是对应宿主路径（写错/留空/缺前导斜杠时
#      应用会归一化或退回内置默认值，不会启动失败，但换算会静默失效）；
#   2) 值要写成宿主的**真实前缀**；路径非标准（如把媒体挂到 /mnt/media）时必须补上；
#   3) 改完只需重启容器（它是启动时读的 env）；**不需要**做任何"重新播种"。
#
# 改完怎么自查：
#   · WebUI 新建/编辑媒体库，填宿主路径 `/vol1/1000/Library/Bangumi`，保存后回看是否
#     原样就是 `/vol1/1000/Library/Bangumi`（恒等映射下不换算也不该报错）；
#   · 硬链接日志里出现的就是宿主路径（`Source: /vol1/1000/Download/qbittorrent/...`）；
#   · 想看配置同步状态用 `GET /api/config`（`last_import_at` / `errors`）；
#   · 静态自验随时可跑：`sh examples/validate-deployment-assets.sh .`（含真实 `ln` 探针）
#
# 注意：整串 JSON 用单引号包裹，内部用双引号（compose 的 YAML 里也是这么写的）。
HOST_PATH_MAP='{"/vol1/1000":"/vol1/1000"}'


# -----------------------------------------------------------------------------
# 6. 可选：会话签名密钥
# -----------------------------------------------------------------------------
# 用于签名登录 Cookie。留空 → 首次启动自动生成 32 字节随机密钥并写入
#   /data/secret.key（权限 0600，随数据卷持久化）。
# 显式设置的价值：在**多实例/重建容器且换数据卷**时保持已登录会话不失效。
# 生成方法（任选其一，输出 64 位十六进制）：
#     openssl rand -hex 32
#     python3 -c "import secrets;print(secrets.token_hex(32))"
# ⚠️ 这是密钥，不要提交到 git、不要贴到聊天里。
SECRET_KEY=


# -----------------------------------------------------------------------------
# 7. 可选：首次启动自动创建管理员
# -----------------------------------------------------------------------------
# 两者都留空 → 首次打开 WebUI 时由页面引导创建管理员（推荐，更安全）。
# 两者都填 → 首次启动自动建号（适合无人值守的自动化部署）。
# 只填其中一个 → 视为不完整，应用会忽略并走"页面引导创建"。
#
# 密码策略：长度 ≥ 8（服务端强校验）。
# 用户名示例：
ADMIN_USERNAME=
# 密码示例（请务必改成自己的强密码；留空表示不自动创建）：
# ADMIN_PASSWORD=ChangeMe_Str0ng!
ADMIN_PASSWORD=


# =============================================================================
# 快速自检（部署后执行）
# =============================================================================
#   docker compose config | head -60        # 检查变量插值是否符合预期
#   docker compose up -d --build
#   docker compose ps                       # STATUS 应为 Up ... (healthy)
#   curl -s http://127.0.0.1:18081/api/system/health
#   docker compose logs --tail=50 media-ingest
#
# 挂载形态自查（两条 bind 才对）：
#   docker inspect media-ingest --format '{{range .Mounts}}{{.Source}} -> {{.Destination}} rw={{.RW}}{{"\n"}}{{end}}'
#     → 应看到 ${MEDIA_ROOT} -> ${MEDIA_ROOT} 与 .../data -> /data 两条；
#       若还能看到 /downloads 或 /library，说明 compose 还是旧形态，硬链接必然失败。
#   docker exec media-ingest sh -c 'findmnt -T /vol1/1000/Download/qbittorrent; findmnt -T /vol1/1000/Library'
#     → 两条命令必须给出**同一个挂载**（同一 MOUNT ID / 同一 SOURCE）。
#
# 常见症状 → 原因：
#   * 任务失败并提示 "跨文件系统错误 … EXDEV" / 日志里 `[Errno 18] Invalid cross-device link`
#       → 源与目标不在**同一个挂载**（不是"不在同一文件系统"——那只是常见原因之一）。
#         99% 是把它们拆成了两条 bind。修法：改成第 3 节的单一共同父挂载（MEDIA_ROOT）。
#         本应用**不会**回退为复制文件，所以现象是"库目录只落一半结构"而不是数据错误。
#   * 预检说"可以创建硬链接"，真跑却全失败（**假绿**）
#       → st_dev 相等**不能**预测 link() 成功（跨 bind 时 st_dev 完全相同但仍 EXDEV）。
#         现行预检以**实证 link 探针**为主判据、mount ID 比较只作预筛
#         （mount ID 相同是必要不充分：btrfs 同挂载跨子卷仍可能 EXDEV）；
#         `same_filesystem` 于是变成三态：true（已实证）/ false（跨挂载）/ null（无法实证）。
#   * 容器 unhealthy，checks.downloads_readable 或 checks.library_writable=false
#       → DB 里「允许的源/目标根目录」还是 /downloads、/library。到 WebUI 设置页改成
#         宿主真实路径（见第 3 节末尾的说明）。
#   * /api/system/health 返回 degraded，checks.config=false
#       → CONFIG_DIR 对容器用户不可写（配置无法落盘、WebUI 会一直显示"不同步"）。宿主执行：
#         sudo mkdir -p '/vol1/1000/Docker/media-ingest/data/config'
#         sudo chown -R 1000:1001 '/vol1/1000/Docker/media-ingest/data'
#   * 容器 unhealthy 但 WebUI 能打开
#       → 端口不一致：确认 compose 的 ports 与 PORT 一致（默认 18081:18081）。
#   * 容器 unhealthy，想知道**到底哪一项**没过（healthcheck 现在会逐条列出）
#       → docker inspect --format '{{json .State.Health}}' media-ingest
#         输出里的 Log[].Output 会带 healthcheck.sh 的 stderr，形如：
#           healthcheck: 不健康 status='degraded'
#             [失败] checks.downloads_readable = False
#             [缺失] checks.db 未出现在响应里
#         判据是 **status == "ok" 且必需 checks 全 true**（六项全部必需：db / data_dir /
#         downloads_readable / library_writable / processors / config；缺任何一项也判 unhealthy）；
#         该端点无论健康与否都返回 HTTP 200，
#         所以"浏览器能打开健康检查页"不等于健康。

# =============================================================================
# 部署完成后的验收清单（本项目的自验脚本覆盖前两项，后两项必须真机验收）
# =============================================================================
#   1) sh examples/validate-deployment-assets.sh .          # 静态自验：应 0 FAIL
#      —— 含"真实 ln 探针"（有界递归找样本文件后 ln 到目标根再删）与挂载形态断言；
#         断言条数会随版本增加，**判据是 0 FAIL，不是某个固定 PASS 数**
#   2) MLM_BUILD_CHECK=1 sh examples/validate-deployment-assets.sh .   # 追加 docker build --check
#   3) docker compose up -d --build && curl -s http://127.0.0.1:18081/api/system/health
#        → 必须 status:"ok"、checks 全为 true（否则 docker compose ps 不会变成 healthy）
#   4) 用 examples/qbittorrent-autorun.md 配好回调，真实下载一个种子，确认
#        ${MEDIA_ROOT}/Library 下出现与源文件 **inode 相同** 的硬链接
#        （stat 比对，见 minimal-repro.sh）
