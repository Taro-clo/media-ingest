# =============================================================================
# media-ingest 环境变量模板
# =============================================================================
# 用法：
#     cp .env.example .env
#     按需修改（至少确认 PUID / PGID / MEDIA_ROOT）
#     docker compose up -d
#
# 说明：
#   * `.env` 只被 `docker compose` 用来填充 docker-compose.yml 里的 ${VAR} 插值；
#     应用代码不读它，容器内的真实环境变量来自 docker-compose.yml 的 environment: 段。
#   * `.env` 可能含密钥，已在 .gitignore 中（`.env` / `.env.*`，`.env.example` 保留）。
#   * 以下每一项在 docker-compose.yml 的 environment: 段都有同名的一行。
#   * 部署细节见 docs/guides/DEPLOYMENT.md，排障见 docs/guides/TROUBLESHOOTING.md。
# =============================================================================


# ---- 1. 运行身份（必需；最常需要改的两项） ---------------------------------
# 容器内进程的 uid / gid，必须能读写下载源与媒体库。
# 查询：id <你的用户>，或 stat -c '%u %g %n' <下载目录>
# 不要改成 0（root）。
PUID=1000
PGID=1001


# ---- 2. 时区与字符集（必需；一般无需修改） ---------------------------------
# 日志时间戳时区。
TZ=Asia/Shanghai
# 不要改成 C / POSIX：当前实现写中文日志时依赖 UTF-8 locale。
LANG=C.UTF-8
PYTHONUTF8=1
PYTHONIOENCODING=utf-8


# ---- 3. 媒体根目录（必需；最关键的一项） -----------------------------------
# 下载源与媒体库的**共同父目录**（宿主路径）。
# compose 把它挂成一条 bind，且容器内路径 = 宿主路径，这样源与目标才在同一个
# 挂载内、硬链接才能成立。拆成两条 bind 会导致硬链接失败（EXDEV）。
# 必须是宿主上真实存在的目录；MEDIA_ROOT=/vol1/1000 时，容器内可见
#   /vol1/1000/Download/qbittorrent（源）与 /vol1/1000/Library（目标）。
MEDIA_ROOT=/vol1/1000


# ---- 4. 应用数据与端口（必需；已给默认值） ---------------------------------
# 数据目录（容器内）：SQLite、任务日志、库日志、secret.key 都在这里。
# 宿主侧对应 docker-compose.yml 的 /data bind，默认
#   /vol1/1000/Docker/media-ingest/data
DATA_DIR=/data

# WebUI 监听端口。宿主映射端口 = 此值（默认 18081）；冲突时改这里即可。
PORT=18081

# 配置文件镜像目录（容器内，位于 /data 卷内，无需单独挂载）。
CONFIG_DIR=/data/config

# 首次建库时"允许的源根目录 / 允许的目标根目录"的初值；只用于 DB 首次播种。
# 已部署实例请到 WebUI「设置」页修改，改这里不生效。
DEFAULT_SOURCE_ROOT=/vol1/1000/Download
DEFAULT_TARGET_ROOT=/vol1/1000/Library


# ---- 5. 可选：路径映射（只用于展示与路径换算，不参与文件操作） -------------
# JSON：容器内绝对路径 → 宿主路径。容器路径 = 宿主路径时即恒等映射（默认）。
# 可选：数据卷在宿主上的位置（compose 插值；不写 = 部署目录下的 ./data）
# MLM_DATA_DIR=/vol1/1000/Docker/media-ingest/data
HOST_PATH_MAP='{"/vol1/1000":"/vol1/1000"}'


# ---- 6. 可选：会话签名密钥 -------------------------------------------------
# 留空 → 首次启动自动生成并写入 /data/secret.key（0600，随数据卷持久化）。
# 生成：openssl rand -hex 32   （这是密钥，不要提交到 git 或贴到聊天里）
SECRET_KEY=


# ---- 7. 可选：首次启动自动创建管理员 ---------------------------------------
# 两者都留空 → 首次打开 WebUI 时由页面引导创建（推荐）。
# 两者都填 → 首次启动自动建号（无人值守部署）；只填一个则忽略走页面引导。
ADMIN_USERNAME=
ADMIN_PASSWORD=
