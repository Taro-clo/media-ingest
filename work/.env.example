# =============================================================================
# media-ingest 环境变量模板
# =============================================================================
# 用法：
#     cp .env.example .env
#     只改 MEDIA_ROOT 就够了（PUID/PGID 默认 auto，会按媒体目录属主自动识别；
#     数据卷默认 ./data）。其余默认值都不用动。
#     docker compose up -d
#
# 说明：
#   * `.env` 只被 `docker compose` 用来填充 docker-compose.yml 里的 ${VAR} 插值；
#     应用代码不读它，容器内的真实环境变量来自 docker-compose.yml 的 environment: 段。
#   * `.env` 可能含密钥，已在 .gitignore 中（`.env` / `.env.*`，`.env.example` 保留）。
#   * 以下每一项在 docker-compose.yml 的 environment: 段都有同名的一行。
#   * 部署细节见 docs/guides/DEPLOYMENT.md，排障见 docs/guides/TROUBLESHOOTING.md。
# =============================================================================


# ---- 1. 运行身份（默认 auto，一般无需修改） --------------------------------
# auto = 按媒体共同父挂载（MEDIA_ROOT）的属主自动识别，也就是"能读下载、能写
# 媒体库"的那个用户。想固定身份就写数字，例如：
#     PUID=1000
#     PGID=1000
# 不要改成 0（root）。
PUID=auto
PGID=auto


# ---- 2. 时区与字符集（必需；一般无需修改） ---------------------------------
# 日志时间戳时区。
TZ=Asia/Shanghai
# 不要改成 C / POSIX：当前实现写中文日志时依赖 UTF-8 locale。
LANG=C.UTF-8
PYTHONUTF8=1
PYTHONIOENCODING=utf-8


# ---- 3. 媒体根目录（唯一必须按你的环境改的一项） ---------------------------
# 下载源与媒体库的**共同父目录**（宿主路径）。程序不假设它叫 /vol1/1000：
# /vol1/1000、/volume1/media、/mnt/user、/srv/media 都可以。
# compose 把它挂成一条 bind，且容器内路径 = 宿主路径，这样源与目标才在同一个
# 挂载内、硬链接才能成立。拆成两条 bind 会导致硬链接失败（EXDEV）。
# 必须是宿主上真实存在的目录；源 / 目标目录在**新建媒体库时自己填**（容器内路径 =
# 宿主路径），只要都落在这条 bind 之下即可，不必叫 Download / Library。
MEDIA_ROOT=/vol1/1000


# ---- 4. 应用数据与端口（都有默认值，一般无需修改） -------------------------
# 数据目录（容器内）：SQLite、任务日志、库日志、secret.key 都在这里。
# 宿主侧对应 docker-compose.yml 的 /data bind，默认是 compose 文件同目录的 ./data。
DATA_DIR=/data

# WebUI 监听端口。宿主映射端口 = 此值（默认 18081）；冲突时改这里即可。
PORT=18081

# 配置文件镜像目录（容器内，位于 /data 卷内，无需单独挂载）。
CONFIG_DIR=/data/config


# ---- 5. 可选：路径映射与数据卷位置 -----------------------------------------
# HOST_PATH_MAP：JSON，容器内绝对路径 → 宿主路径，只用于展示与路径换算。
# 单挂载形态下容器路径 = 宿主路径，所以默认空映射 = 恒等，**不需要填**；
# 只有把媒体挂到不同容器路径时（如 -v /srv/media:/media）才需要显式写。
HOST_PATH_MAP='{}'

# 可选：数据卷在宿主上的位置（compose 插值；不写 = compose 文件同目录的 ./data）
# MLM_DATA_DIR=/vol1/1000/Docker/media-ingest/data


# ---- 6. 可选：会话签名密钥 -------------------------------------------------
# 留空 → 首次启动自动生成并写入 /data/secret.key（0600，随数据卷持久化）。
# 生成：openssl rand -hex 32   （这是密钥，不要提交到 git 或贴到聊天里）
SECRET_KEY=


# ---- 7. 可选：首次启动自动创建管理员 ---------------------------------------
# 两者都留空 → 首次打开 WebUI 时由页面引导创建（推荐）。
# 两者都填 → 首次启动自动建号（无人值守部署）；只填一个则忽略走页面引导。
ADMIN_USERNAME=
ADMIN_PASSWORD=
